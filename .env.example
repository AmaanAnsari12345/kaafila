# ---------------------------------------------------------------------------
# KAAFILA environment. Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Shared
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Database and cache
DATABASE_URL=postgresql://kaafila:kaafila@localhost:5432/kaafila?schema=public
REDIS_URL=redis://localhost:6379

# Auth (Supabase: email magic link + Google)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local development only: lets the web app sign in as "dev-token:<name>" users.
# The API refuses to start with ALLOW_DEV_TOKEN=true in production.
ALLOW_DEV_TOKEN=true
NEXT_PUBLIC_DEV_AUTH=true

# Maps (web). Default: OpenFreeMap public style (free, no key, provided as-is).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Routing / geocoding / places / weather (API).
# The public OSRM demo, Nominatim and Overpass instances are for development only:
# self-host them or use a paid provider before launch (see docs/BLUEPRINT.md §7).
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# Open-Meteo's free API is non-commercial. For production use the commercial endpoint + key.
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
# Identifies the app to OpenStreetMap services, e.g. "KAAFILA/1.0 (+https://kaafila.app)"
OSM_USER_AGENT=

# Voice / video (LiveKit)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=

# AI co-pilot (Claude). Without a key the co-pilot answers with rule-based responses.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
# Voice mode answers with lower effort for faster first words (low | medium | high).
ASSISTANT_VOICE_EFFORT=low
# Per-user co-pilot questions per hour, and total public app-help questions per day.
ASSISTANT_HOURLY_LIMIT=60
ASSISTANT_PUBLIC_DAILY_LIMIT=2000

# Web Push (background SOS alerts). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or https://your-site
VAPID_SUBJECT=

# Billing: KAAFILA Drive = INR 500 per car per month.
# inclusive: customer pays exactly 500 (GST carved out). exclusive: 500 + GST.
PRICE_TAX_MODE=inclusive
GST_RATE=0.18
# Razorpay: create a monthly plan whose amount matches the tax mode (50000 paise inclusive,
# 59000 paise exclusive) and put its id here. Subscriptions use quantity = number of cars.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_DRIVE=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Stripe (international): a recurring monthly Price for one car; quantity = number of cars.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_DRIVE=

# Operations
ENABLE_API_DOCS=false
# Data retention job (location pings by plan, expired links, old webhook events, ...).
RETENTION_ENABLED=true
RETENTION_INTERVAL_MINUTES=60
NEXT_PUBLIC_SUPPORT_EMAIL=
SENTRY_DSN=
