{
  "name": "kaafila",
  "version": "0.1.0",
  "private": true,
  "description": "KAAFILA Connected Convoy Operating System monorepo.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "hostinger:prepare": "node scripts/prepare-hostinger-bundles.mjs",
    "db:generate": "pnpm --filter @kaafila/api db:generate",
    "db:migrate": "pnpm --filter @kaafila/api db:migrate",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.15.0"
  }
}
